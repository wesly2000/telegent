TELEGENT_CAPTURE_ROOT=/absolute/path/to/captures
TELEGENT_AGENT_CONFIG_ROOT=/absolute/path/to/agent-config
# Set this to the agent selected with --agent. For OpenCode, use the executable
# built with the SSLKEYLOG-enabled Bun runtime.
TELEGENT_AGENT_BINARY=/absolute/path/to/opencode
TELEGENT_CAPTURE_INTERFACE=eth0
TELEGENT_CAPTURE_FILTER=port 443
TELEGENT_TAIL_SECONDS=10
TELEGENT_REQUEST_INTERVAL_SECONDS=0
TELEGENT_CAPTURE_START_TIMEOUT_SECONDS=5
# TELEGENT_ANALYSIS_ROOT=/absolute/path/to/telegent-analysis
# TELEGENT_METRICS_DB=/absolute/path/to/telegent-analysis/database.db
# TELEGENT_TEST_TIMEOUT_SECONDS=60
# TELEGENT_SEQUENCE_SCRIPT=/absolute/path/to/custom-sequence.sh
# TELEGENT_PROMPTS_FILE=/absolute/path/to/prompts.txt
# TELEGENT_MODEL_PROVIDER=openrouter
# TELEGENT_TSHARK_BINARY=/usr/bin/tshark
