{
  "$schema": "https://opencode.ai/config.json",
  "model": "glm/glm-5.3-flash",
  "provider": {
    "glm": {
      "name": "ZAI GLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash"
        }
      }
    }
  }
}
